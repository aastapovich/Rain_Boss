## Запись в таблице типов дождя — сцена капли + её вес при случайном выборе.
## Используется в RainManager.drop_entries и CloudLayer.rain_config.
##
## Вес — относительный: [вода 97, золото 2, жизнь 1] = 100 частей суммарно.
## Чтобы добавить новый тип — создай .tres с нужной сценой и весом.
## Чтобы убрать тип на уровне — enabled = false (без удаления из списка).
class_name RainDropEntry
extends Resource

## Сцена капли для инстанциирования.
@export var scene: PackedScene = null

## Относительный вес при случайном выборе (0.0–100.0).
## Пример: вода=97, золото=2, жизнь=1 → 97% воды, 2% золота, 1% жизни.
@export_range(0.0, 100.0, 0.5) var weight: float = 1.0

## Временно отключить этот тип капли без удаления из списка.
@export var enabled: bool = true
